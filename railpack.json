{
  "$schema": "https://schema.railpack.com",
  "provider": "golang",
  "steps": {
    "build": {
      "commands": [
        "rm assets/config/openlore.yml",
        "go build -o out ./cmd/openlore"
      ]
    }
  },
  "deploy": {
    "startCommand": "./out",
    "variables": {
      "OPENLORE_CONFIG_FILE": "/var/lib/openlore/config/openlore.yml",
      "OPENLORE_CONFIG_SEED": "/app/openlore.yml",
      "OPENLORE_AUTH_FILE": "/var/lib/openlore/config/lore.json",
      "OPENLORE_AUTH_SEED": "/app/lore.json",
      "OPENLORE_INIT_DIRS": "/var/lib/openlore/data,/var/lib/openlore/published,/var/lib/openlore/ssh",
      "OPENLORE_METRICS_PORT": "0"
    },
    "inputs": [
      "...",
      {
        "local": true,
        "include": [
          "deploy/onboarding/lore.json",
          "deploy/onboarding/openlore.yml"
        ]
      }
    ]
  }
}
