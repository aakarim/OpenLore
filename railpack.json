{
  "$schema": "https://schema.railpack.com",
  "provider": "golang",
  "steps": {
    "build": {
      "commands": [
        "rm assets/config/openlore.yml",
        "go build -o out ./cmd/openlore"
      ]
    }
  },
  "deploy": {
    "startCommand": "sh start.sh",
    "inputs": [
      "...",
      {
        "local": true,
        "include": [
          "deploy/onboarding/lore.json",
          "deploy/onboarding/openlore.yml",
          "deploy/onboarding/start.sh"
        ]
      }
    ]
  }
}
