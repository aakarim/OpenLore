{
  "allow_keyless": true,
  "unknown_identity": "allow",
  "default_cwd": "/docs/public",
  "roles": {
    "engineer": {
      "comment": "Engineering agents",
      "allow": { "capabilities": ["spawn", "lore:config:edit"] }
    },
    "reviewer": {
      "allow": { "capabilities": ["review"] },
      "deny": { "capabilities": ["spawn"] }
    }
  },
  "docsets": {
    "public": {
      "paths": ["/docs/public"],
      "access": { "allow": { "guest": "ro", "engineer": "rw", "reviewer": "ro" } }
    },
    "backend": {
      "paths": ["/docs/backend"],
      "inbox": "inbox",
      "access": {
        "allow": { "engineer": "rw", "reviewer": "publish" },
        "deny": []
      },
      "rules": {
        "format": { "match": ["**/*.md"], "use": "okf" },
        "doc-size": { "match": ["**/*.md"], "use": "size/kilobytes", "with": { "max": 60 }, "default": true }
      },
      "config": { "edit": ["engineer"] }
    },
    "engineer-home": {
      "paths": [{ "published/engineer": "/home/engineer" }]
    }
  },
  "identities": [
    {
      "name": "backend-agent",
      "comment": "Backend automation",
      "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleBackendKeyHere backend-agent",
      "roles": ["engineer", "reviewer"],
      "home": "engineer-home",
      "delegates": [
        {
          "identity": "claude@claude.ai",
          "deny_docsets": ["backend"],
          "deny_capabilities": ["lore:config:edit"]
        }
      ]
    },
    {
      "name": "claude@claude.ai",
      "comment": "Display: Claude Desktop",
      "created_by": "oauth"
    },
    {
      "name": "passkey-only-reviewer",
      "roles": ["reviewer"]
    }
  ]
}
